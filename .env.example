# ── COPY THIS TO .env AND FILL IN YOUR VALUES ─────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=ssi_secret_change_me_in_production

# ── Security (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production-32-chars!!
# Generate a valid Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key-base64-32ch=

# ── LinkedIn Credentials ───────────────────────────────────────────────────────
LINKEDIN_USERNAME=your.email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── AI Provider ────────────────────────────────────────────────────────────────
# Options: openai | claude
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Email Reporting ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
# Use an App Password for Gmail: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_password
REPORT_FROM_EMAIL=your.email@gmail.com
REPORT_TO_EMAIL=recipient@example.com

# ── Scheduling ─────────────────────────────────────────────────────────────────
# Cron expression (default: 09:00 UTC daily)
SCRAPE_CRON=0 9 * * *
# Cron expression for email reports (default: 10:00 UTC daily)
REPORT_CRON=0 10 * * *
